{
  "name": "@woodid/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "import:species": "tsx scripts/importSpecies.ts",
    "import:cites-species": "tsx scripts/importCitesSpecies.ts",
    "import:north-american-species": "tsx scripts/addNorthAmericanSpecies.ts",
    "import:misc-species": "tsx scripts/addMiscSpecies.ts",
    "cleanup:junk-species": "tsx scripts/cleanupJunkSpecies.ts",
    "restore:jackalberry": "tsx scripts/restoreJackalberry.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^26.1.2",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.21.0"
  }
}
