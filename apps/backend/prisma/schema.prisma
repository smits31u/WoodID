// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Species {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commonName     String
  scientificName String @unique
  family         String
  originRegions  String

  jankaHardness Int
  density       Float

  grainType     String
  texture       String
  poreStructure String

  heartwoodColor String
  sapwoodColor   String

  workabilityRating Int
  workabilityNotes  String

  commonUses           String
  sustainabilityStatus String
  citesListed          Boolean

  referencePhotos ReferencePhoto[]
}

enum PhotoAngle {
  FACE_GRAIN
  EDGE_GRAIN
  END_GRAIN
}

enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
}

model ReferencePhoto {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  speciesId Int
  species   Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  imageUrl String
  angle    PhotoAngle
  status   ContentStatus @default(PENDING)
  deviceId String
}

model SpeciesSuggestion {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  proposedCommonName     String
  proposedScientificName String?
  submitterNotes         String?
  deviceId               String
  status                 ContentStatus @default(PENDING)

  photos SuggestionPhoto[]
}

model SuggestionPhoto {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  suggestionId Int
  suggestion   SpeciesSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  imageUrl String
}
