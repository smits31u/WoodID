# Prisma supports the native connection string format for PostgreSQL.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Anthropic API key used for AI-powered species identification (POST /species/identify).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# CITES Species+ API token used by scripts/importSpecies.ts to look up listing status.
# Free for non-commercial use — sign up at https://api.speciesplus.net
CITES_API_TOKEN=""
